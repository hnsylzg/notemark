<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  文件关联：安装后让 .md / .markdown 可以用 NoteMark 打开

  要点：
  - 全部写 HKCU，安装不需要管理员权限；
  - exe 路径用 [!Path] 引用（File 元素 Id="Path"），不硬编码文件名，
    这样即使 productName 变化导致 exe 改名也不用改这里；
  - 专有键（NoteMark.md / Applications\notemark.exe）用
    Action="createAndRemoveOnUninstall"，卸载时整个删除；
  - 共享键（.md\OpenWithProgids）**故意不设** createAndRemoveOnUninstall：
    卸载时只移除我们写入的 NoteMark.md 值，绝不删整个 OpenWithProgids，
    否则会连带清掉其他程序对 .md 的关联。
  ============================================================
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- 尽力默认：安装时若 .md/.markdown 从未设置过默认程序，则写入 NoteMark.md 默认值 -->
    <Property Id="MD_USERCHOICE">
      <RegistrySearch Id="MdUserChoiceSearch" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.md\UserChoice"
                      Name="ProgId" Type="raw" />
    </Property>
    <Property Id="MD_DEFAULT">
      <RegistrySearch Id="MdDefaultSearch" Root="HKCU" Key="Software\Classes\.md" Type="raw" />
    </Property>
    <Property Id="MD_DEFAULT_MACHINE">
      <RegistrySearch Id="MdDefaultMachineSearch" Root="HKLM" Key="Software\Classes\.md" Type="raw" />
    </Property>
    <Property Id="MARKDOWN_USERCHOICE">
      <RegistrySearch Id="MarkdownUserChoiceSearch" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.markdown\UserChoice"
                      Name="ProgId" Type="raw" />
    </Property>
    <Property Id="MARKDOWN_DEFAULT">
      <RegistrySearch Id="MarkdownDefaultSearch" Root="HKCU" Key="Software\Classes\.markdown" Type="raw" />
    </Property>
    <Property Id="MARKDOWN_DEFAULT_MACHINE">
      <RegistrySearch Id="MarkdownDefaultMachineSearch" Root="HKLM" Key="Software\Classes\.markdown" Type="raw" />
    </Property>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="NoteMarkFileAssoc" Guid="*">

        <!-- 专有 ProgID，卸载时整键删除。
             注意：DefaultIcon 必须是"子键"形式（图标路径放子键的默认值），
             Windows 才会去解析 path,index 里的索引。写在父键的同名值下 Windows 不认。 -->
        <RegistryKey Root="HKCU"
                     Key="Software\Classes\NoteMark.md"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="Markdown Document" KeyPath="yes" />
        </RegistryKey>

        <RegistryKey Root="HKCU"
                     Key="Software\Classes\NoteMark.md\DefaultIcon"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="[!Path],1" />
        </RegistryKey>

        <RegistryKey Root="HKCU"
                     Key="Software\Classes\NoteMark.md\shell\open\command"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
        </RegistryKey>

        <!-- 让 NoteMark 出现在「打开方式」列表里 -->
        <RegistryKey Root="HKCU"
                     Key="Software\Classes\Applications\notemark.exe"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Name="FriendlyAppName" Value="NoteMark" />
        </RegistryKey>

        <RegistryKey Root="HKCU"
                     Key="Software\Classes\Applications\notemark.exe\DefaultIcon"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="[!Path],1" />
        </RegistryKey>

        <RegistryKey Root="HKCU"
                     Key="Software\Classes\Applications\notemark.exe\shell\open\command"
                     Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
        </RegistryKey>

        <!-- 共享键：不设 createAndRemoveOnUninstall，只写入值 -->
        <RegistryKey Root="HKCU" Key="Software\Classes\.md\OpenWithProgids">
          <RegistryValue Type="string" Name="NoteMark.md" Value="" />
        </RegistryKey>

        <RegistryKey Root="HKCU" Key="Software\Classes\.markdown\OpenWithProgids">
          <RegistryValue Type="string" Name="NoteMark.md" Value="" />
        </RegistryKey>

      </Component>

      <!-- 尽力默认：仅当该扩展名从未设置过默认程序时写入 NoteMark.md 默认值。
           条件为假时整个组件不安装，绝不抢已有默认；卸载时由 MSI 自动清除该值。 -->
      <Component Id="NoteMarkMdDefault" Guid="*">
        <Condition>NOT MD_USERCHOICE AND NOT MD_DEFAULT AND NOT MD_DEFAULT_MACHINE</Condition>
        <RegistryKey Root="HKCU" Key="Software\Classes\.md">
          <RegistryValue Type="string" Value="NoteMark.md" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="NoteMarkMarkdownDefault" Guid="*">
        <Condition>NOT MARKDOWN_USERCHOICE AND NOT MARKDOWN_DEFAULT AND NOT MARKDOWN_DEFAULT_MACHINE</Condition>
        <RegistryKey Root="HKCU" Key="Software\Classes\.markdown">
          <RegistryValue Type="string" Value="NoteMark.md" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
